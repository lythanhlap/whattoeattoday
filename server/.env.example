NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/recipe_community"
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
AUTH_COOKIE_NAME=recipe_refresh_token
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret
CLOUDINARY_MAX_FILE_SIZE=5242880
REDIS_URL=redis://localhost:6379
